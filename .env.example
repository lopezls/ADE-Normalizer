# Neon connection string. Vercel's Neon integration sets STORAGE_DATABASE_URL (prefix chosen at setup); DATABASE_URL also works
STORAGE_DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Anthropic API key for /api/analyze (server only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Live microphone (Deepgram speech-to-text). Server only.
DEEPGRAM_API_KEY=
# Required in production for the Microphone mode; type it in the box on the call screen.
# Optional in local development.
LIVE_CALL_PASSCODE=
